import pandas as pd
from sklearn.linear_model import LinearRegression

data = pd.DataFrame({
    'Year': [2015, 2016, 2017, 2018, 2019, 2020],
    'Kilometers': [50000, 45000, 40000, 35000, 30000, 20000],
    'Price': [300000, 350000, 400000, 450000, 500000, 600000]
})

X = data[['Year', 'Kilometers']]
y = data['Price']

model = LinearRegression()
model.fit(X, y)

prediction = model.predict([[2021, 15000]])

print("Predicted Car Price:", prediction[0])

